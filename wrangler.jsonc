{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mazatzalhiking",
  "compatibility_date": "2026-07-15",
  // The script handles /api/* only (the contact form); every other path is a static
  // file in public/ and never reaches it.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Contact form mail: Email Routing on mazatzalhiking.com, sent only to a verified
  // destination. The address itself is the CONTACT_TO secret, so it stays out of the repo.
  "send_email": [{ "name": "CONTACT" }],
  "vars": {
    "CONTACT_FROM": "contact@mazatzalhiking.com"
  }
}
