{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- /* Hugo's default sitemap, plus one rule: the builder is listed only when
         builderPublic is on (#47). */ -}}
  {{- range .Pages }}
  {{- if and (eq .Type "build") (not site.Params.builderPublic) }}{{ continue }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
  </url>
  {{- end }}
</urlset>
